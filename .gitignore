# Ignore local Claude state (settings, launch config) but TRACK the project skills
.claude/*
!.claude/skills/
.superpowers/
design-handoff/
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/backups/
__pycache__/
*.pyc
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*
**/.env.local
config.json
config.backup*.json
SECRETS_LOCAL_ONLY.md
*.egg-info/
.pytest_cache/
.playwright-mcp/
*.log
*.err
*.state
.worktrees/
data/*.session
data/telegram_pending.json

# Large downloaded binary — fetched/run by the watchdog, never committed (~52MB)
scripts/cloudflared.exe

# Stale build artifact at repo root. The REAL build output is mass-market-app/dist
# (that's what gets drag-deployed to Netlify). A tracked root dist/ here was a trap:
# dragging it shipped a months-old build (dead ngrok API URL, no _redirects).
/dist/

# Auto-generated banner archive snapshots (written by archive.py at runtime, ~100s of PNGs)
/data/archive/banners/

# Ad-hoc scratch / analysis files (root, underscore-prefixed) + local scraper debug dumps
/_*
/data/_*
/data/cellcom_*
/data/item_*.pdf

# Local Netlify folder
.netlify

# Packaged sites-moca build (dist tarball) — regenerable from sites-moca/, never committed
sites-moca-package.tar.gz

# TWA (Google Play) - signing key + credentials must NEVER be committed
twa/android.keystore
twa/.keystore-pass
twa/app/
twa/build/
twa/gradle*
twa/*.apk
twa/*.aab
twa/*.idsig
twa/node_modules/
